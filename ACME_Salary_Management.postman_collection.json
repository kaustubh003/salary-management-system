  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saves the session token in the collection variable {{token}}. Every other request sends it as a bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains a token\", function () { pm.expect(json.token).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Employees",
      "item": [
        {
          "name": "Add employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"{{employeeCode}}\",\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Rao\",\n  \"department\": \"Finance\",\n  \"jobTitle\": \"Analyst\",\n  \"address\": \"Pune\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"{{email}}\",\n  \"country\": \"India\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh employee on every run, so the collection can be run again without clashes",
                  "const suffix = Math.floor(10000 + Math.random() * 90000);",
                  "pm.collectionVariables.set(\"employeeCode\", \"E\" + suffix);",
                  "pm.collectionVariables.set(\"phone\", \"9\" + Math.floor(100000000 + Math.random() * 900000000));",
                  "pm.collectionVariables.set(\"email\", \"asha.\" + suffix + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Returned employee matches the request\", function () { pm.expect(json.employeeCode).to.eql(pm.collectionVariables.get(\"employeeCode\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Add the same employee again (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
