      "name": "5. Payments",
      "item": [
        {
          "name": "Add payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salaryId\": {{salaryId}},\n  \"periodStart\": \"2026-01-01\",\n  \"periodEnd\": \"2026-01-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "After the salary update the gross is 100000 and the salary net is 83800. January 2026 has 22 weekdays, so 2 unpaid days cost 100000 x 2 / 22 = 9090.91, and the amount paid is 74709.09."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Payment is marked PAID\", function () { pm.expect(json.paidStatus).to.eql(\"PAID\"); });",
                  "pm.test(\"Two unpaid leave days were counted\", function () { pm.expect(json.unpaidLeaveDays).to.eql(2); });",
                  "pm.test(\"Leave deduction is 2 days of gross over 22 weekdays\", function () { pm.expect(Number(json.leaveDeduction)).to.eql(9090.91); });",
                  "pm.test(\"Net is the salary net minus the deduction\", function () { pm.expect(Number(json.netSalary)).to.eql(74709.09); });",
                  "pm.collectionVariables.set(\"paymentId\", json.paymentID);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add payment for a month without leave",
          "request": {
            "method": "POST",
            "header": [
