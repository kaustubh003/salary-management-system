{
  "info": {
    "_postman_id": "fafff1ed-2c00-45e2-a624-19612c8e7396",
    "name": "ACME Salary Management API",
    "description": "Requests and checks for the ACME Salary Management backend.\n\n1. Start the application (default http://localhost:8080).\n2. If you changed the HR manager's credentials, update the username and password collection variables.\n3. Open the Collection Runner and run the folders in order. Each run creates a new employee with a random code, so it can be repeated.\n\nMost requests carry tests. Requests marked 'expect 4xx' check that the API rejects bad input.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "hr.manager"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employeeCode",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "salaryId",
      "value": ""
